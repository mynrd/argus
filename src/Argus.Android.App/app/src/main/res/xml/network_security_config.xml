<?xml version="1.0" encoding="utf-8"?>
<!--
  Argus serves plain HTTP. The host it runs on is typed in by the user - a Tailscale address or a
  LAN IP - so there is no fixed domain to pin here and cleartext has to be allowed everywhere.

  That means the password and the desktop stream cross the network unencrypted. Tailscale is what
  makes it acceptable: the tailnet is already an encrypted overlay. On a plain LAN it is not.
  Putting `tailscale serve` in front of the agent gets HTTPS, and https:// URLs work here too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
