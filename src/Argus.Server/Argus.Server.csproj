<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 10.0.20348 is the lowest Windows SDK ref exposing GraphicsCaptureSession.IsBorderRequired.
         SupportedOSPlatformVersion stays at 19041 so the binary still loads on Win10 1903+,
         where the WGC path works but always draws the yellow capture border. -->
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Argus.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- No MessagePack: SignalR carries JSON control messages only. Frames go over a
         dedicated binary WebSocket (/ws/frames) to avoid base64 inflation. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Argus.Server.Tests" />
  </ItemGroup>

  <!-- The console-inject helper must exist as its own executable: AttachConsole is process-wide,
       so running it in-process would detach this server from its own console and kill its logging.
       ReferenceOutputAssembly=false because we need the .exe on disk, not an assembly reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Argus.ConsoleInject\Argus.ConsoleInject.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- The terminal host must be its own executable for the opposite reason to ConsoleInject: it
       has to OUTLIVE this process. It owns every pseudo console, so a server restart, rebuild or
       crash must not take an open terminal with it. Same ReferenceOutputAssembly=false - what is
       needed is the .exe on disk, not an assembly reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Argus.TerminalHost\Argus.TerminalHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyTerminalHost" AfterTargets="Build">
    <ItemGroup>
      <TerminalHostOutput Include="$(MSBuildThisFileDirectory)..\Argus.TerminalHost\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>
    <!-- A daemon that is already running holds its own .exe open, and it is meant to: it survives
         this build precisely so the terminals it owns do. So the copy is allowed to fail rather
         than failing the build, and Retries=0 keeps it from spending ten seconds discovering that.
         The running daemon keeps serving the previous build until it is stopped or a protocol
         change makes the server retire it - which is what the version handshake is for. -->
    <Copy SourceFiles="@(TerminalHostOutput)"
          DestinationFolder="$(OutDir)TerminalHost\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Retries="0"
          ContinueOnError="true"
          Condition="'@(TerminalHostOutput)' != ''">
      <Output TaskParameter="CopiedFiles" ItemName="TerminalHostCopied" />
    </Copy>

    <Message Importance="high"
             Condition="@(TerminalHostCopied->Count()) &lt; @(TerminalHostOutput->Count())"
             Text="The terminal host is already running, so this build did not replace it. Open terminals keep running; stop Argus.TerminalHost.exe to pick up the new build." />
  </Target>

  <Target Name="CopyConsoleInjectHelper" AfterTargets="Build">
    <ItemGroup>
      <ConsoleInjectOutput Include="$(MSBuildThisFileDirectory)..\Argus.ConsoleInject\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConsoleInjectOutput)"
          DestinationFolder="$(OutDir)ConsoleInject\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ConsoleInjectOutput)' != ''" />
  </Target>

</Project>
