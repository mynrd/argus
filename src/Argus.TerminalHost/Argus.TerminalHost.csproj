<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Argus.TerminalHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Argus.TerminalHost</AssemblyName>
    <!-- Nothing ever reads this process's console: it is spawned DETACHED_PROCESS with no window.
         WinExe would hide it too, but Exe keeps `dotnet run` on this project usable when debugging
         the daemon by hand, and stderr still reaches a console that starts it deliberately. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Argus.Server.Tests" />
  </ItemGroup>

</Project>
